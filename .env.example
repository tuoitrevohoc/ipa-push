# URL public mà iPhone truy cập được — BẮT BUỘC https:// thì iOS mới chịu cài OTA
IPA_PUSH_BASE_URL=https://ipa-push.example.com
# Token bảo vệ API upload/xóa + MCP qua HTTP (đổi thành chuỗi ngẫu nhiên của bạn)
IPA_PUSH_TOKEN=doi-token-nay-di
# Thư mục lưu IPA (mặc định ./data)
#IPA_PUSH_DIR=/path/to/data
# Port web app (mặc định 8765)
#IPA_PUSH_PORT=8765
# Thêm host được phép gọi MCP qua HTTP (mặc định: hostname của BASE_URL + localhost)
#IPA_PUSH_ALLOWED_HOSTS=
